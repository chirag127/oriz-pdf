---
import '../styles/global.css'
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'oriz-pdf — free PDF merge, split, rotate & convert, no signup',
  description = 'Free online PDF toolkit — merge, split, rotate, reorder, extract pages, text, or images, and convert images to PDF. 100% in your browser: no upload, no signup, unlimited files.',
} = Astro.props

const SITE = 'https://pdf.oriz.in/'
const OG_IMAGE = new URL('icons/icon-512.png', SITE).href
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'oriz-pdf',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  url: SITE,
  description,
  browserRequirements: 'Requires JavaScript. Runs entirely client-side.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={SITE} />

    <meta property="og:site_name" content="oriz-pdf" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE} />
    <meta property="og:image" content={OG_IMAGE} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#22d3ee" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' })
        })
      }
    </script>
  </head>
  <body>
    <OzToolShell site="pdf" title="PDF DRAFTING TABLE" wordmarkHref="https://oriz.in">
      <slot />
      <Fragment slot="footer">
        <span class="mono">100% client-side · no upload · no signup</span>
      </Fragment>
    </OzToolShell>
  </body>
</html>
